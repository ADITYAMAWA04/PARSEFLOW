# ParseFlow configuration. Copy to .env (never commit .env). Everything here is optional:
# the offline pipeline (text layer, tables, math from the text layer, Tesseract OCR) needs no keys.

# --- optional AI (reads text in images, answers questions in Ask). ONE key does both. ---
# Easiest: run the app and click "Connect AI" (it saves the key here). Or fill in:
#   Google AI Studio key (free tier, starts with AIza): https://aistudio.google.com/apikey
#   Groq key (free tier, starts with gsk_):              https://console.groq.com/keys
#   Anthropic key (paid, starts with sk-ant-):          https://console.anthropic.com
#   OpenAI key (paid, starts with sk-) or OpenRouter (sk-or-)
AI_API_KEY=
AI_PROVIDER=                       # optional: gemini | groq | anthropic | openai | openrouter | ollama | compatible
AI_MODEL=                          # optional; empty = picked automatically from the provider's model list
# AI_VISION_MODEL=                 # optional model for reading images (Groq/OpenAI/Ollama)
# AI_BASE_URL=http://localhost:1234/v1   # any OpenAI-compatible server (LM Studio, vLLM, ...); key optional
# GEMINI_BUSY_WAIT_S=4             # when every Gemini model is overloaded: wait this long and retry once
MAX_VISION_REGIONS=40              # images read by AI while processing; the rest via "Read with AI"
# Older names still work: VISION_API_KEY / VISION_PROVIDER / VISION_MODEL, LLM_API_KEY / LLM_PROVIDER / LLM_MODEL.
# Tesseract (offline OCR) is found on PATH or in its default install folder; else set TESSERACT_CMD=

# --- optional high-accuracy page OCR (a document OCR model such as AllenAI olmOCR-2) ---
# Used by `bench/run_benchmark.py --engine vlm`, `python -m backend.cli ... --engine vlm`, and by the app
# for every page when set. See docs/BENCHMARK.md. Any OpenAI-compatible server works.
# Not needed for normal use. Key: deepinfra.com -> sign up -> Dashboard -> API keys (add a little credit).
VLM_SERVER=                        # e.g. https://api.deepinfra.com/v1/openai  or  http://localhost:8000/v1
VLM_API_KEY=
VLM_MODEL=                         # default allenai/olmOCR-2-7B-1025
# VLM_CONCURRENCY=4                # pages in flight in the app
# VLM_APP_PAGE_BUDGET_S=120        # in the app, give up on a page after this long and use ParseFlow's own reading
# VLM_APP_RETRIES=3                # attempts per page in the app (the benchmark keeps olmOCR's 8)
# HIGH_ACCURACY_OCR=0              # keep VLM_* for the CLI/benchmark but not use it in the app

# --- accounts and saved documents ---
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require   # cloud hosts: keeps accounts and saved documents (Neon, Supabase)
# GUEST_RETENTION_HOURS=24         # documents of people who are not logged in are deleted after this (0 = keep)

# --- other document formats ---
# LibreOffice (free, libreoffice.org) is used when installed for Word/PowerPoint layout and old .doc/.ppt/.xls.
# LIBREOFFICE=C:\Program Files\LibreOffice\program\soffice.exe   # if it is not found automatically
# PARSEFLOW_OFFICE=builtin         # never use LibreOffice (DOCX/PPTX/XLSX/RTF still open)

# --- processing ---
# No page limit. (MAX_PAGES from older versions is ignored.) To cap pages on a small host:
# PARSEFLOW_PAGE_LIMIT=500
OCR_DPI=300
OCR_LANG=eng
OCR_WORKERS=2                      # parallel Tesseract processes for scanned pages
PAGE_TIMEOUT_S=120
STRIP_HEADERS_FOOTERS=1
MATH_FROM_TEXT_LAYER=1
BORDERLESS_TABLES=1
FIGURE_OCR=1

# --- server ---
MAX_UPLOAD_MB=200                  # serverless default is 4 (Vercel rejects bodies over 4.5 MB)
JOB_WORKERS=2
# PARSEFLOW_DATA_DIR=./data        # serverless default: /tmp/parseflow (ephemeral)
# PARSEFLOW_MODE=sync              # force inline processing (set automatically on Vercel)
# SYNC_MAX_PAGES=25
